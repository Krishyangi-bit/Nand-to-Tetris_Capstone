// The Hack CPU: A register, D register, ALU and PC.
//
// Instruction formats:
//   A-instruction: 0vvv vvvv vvvv vvvv          -> A = v
//   C-instruction: 111a cccc ccdd djjj
//       a       = instruction[12]   (0: ALU uses A, 1: ALU uses M)
//       c1..c6  = instruction[11..6] (zx nx zy ny f no)
//       d1 d2 d3 = instruction[5] (A), [4] (D), [3] (M)
//       j1 j2 j3 = instruction[2] (<0), [1] (=0), [0] (>0)
CHIP CPU {

    IN  inM[16],         // M value input  (M = contents of RAM[A])
        instruction[16], // Instruction for execution
        reset;           // 1: restart the program (pc = 0)

    OUT outM[16],        // M value output
        writeM,          // Write to M?
        addressM[15],    // Address in data memory (of M)
        pc[15];          // Address of next instruction

    PARTS:
    // ---- Decode -------------------------------------------------------
    Not(in=instruction[15], out=isA);
    And(a=instruction[15], b=true, out=isC);

    // ---- A register ---------------------------------------------------
    // A-instruction: load the instruction itself.
    // C-instruction with d1: load the ALU output.
    Mux16(a=instruction, b=aluOut, sel=isC, out=aIn);
    And(a=isC, b=instruction[5], out=cWritesA);
    Or(a=isA, b=cWritesA, out=loadA);
    ARegister(in=aIn, load=loadA, out=aOut, out[0..14]=addressM);

    // ---- D register ---------------------------------------------------
    And(a=isC, b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dOut);

    // ---- ALU ----------------------------------------------------------
    // The a-bit picks A or M as the ALU's y input.
    Mux16(a=aOut, b=inM, sel=instruction[12], out=aOrM);
    ALU(x=dOut, y=aOrM,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9],  ny=instruction[8],
        f=instruction[7],   no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // ---- writeM -------------------------------------------------------
    And(a=isC, b=instruction[3], out=writeM);

    // ---- Jump ---------------------------------------------------------
    Or(a=zr, b=ng, out=zeroOrNeg);
    Not(in=zeroOrNeg, out=pos);                       // out > 0
    And(a=instruction[2], b=ng,  out=jumpNeg);        // JLT part
    And(a=instruction[1], b=zr,  out=jumpZero);       // JEQ part
    And(a=instruction[0], b=pos, out=jumpPos);        // JGT part
    Or(a=jumpNeg, b=jumpZero, out=jumpNegOrZero);
    Or(a=jumpNegOrZero, b=jumpPos, out=jumpCond);
    And(a=isC, b=jumpCond, out=jump);                 // only C-instructions jump

    // ---- Program counter ----------------------------------------------
    PC(in=aOut, load=jump, inc=true, reset=reset, out[0..14]=pc);
}
